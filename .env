# ============================================
# APP
# ============================================
APP_NAME="Астролог"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================
# DATABASE (PostgreSQL) - Docker
# ============================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ai_astrolog1
DB_USERNAME=ai_astrolog1
DB_PASSWORD=secret

# ============================================
# REDIS - Docker
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# TIMEWEB AI API
# ============================================
TIMEWEB_API_KEY=your_timeweb_api_key_here
TIMEWEB_AI_MODEL=llama-3-70b
TIMEWEB_AI_TIMEOUT=60

# ============================================
# Т-БАНК (Эквайринг) - TEST MODE
# ============================================
TBANK_TERMINAL_KEY=test_terminal_key
TBANK_SECRET_KEY=test_secret_key
TBANK_WEBHOOK_URL=http://localhost:8000/api/webhooks/tbank

# ============================================
# UNISENDER (Email) - TEST MODE
# ============================================
UNISENDER_API_KEY=test_unisender_key
UNISENDER_SENDER_EMAIL=noreply@localhost
UNISENDER_SENDER_NAME="Астролог"

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# MAX BOT
# ============================================
MAX_BOT_TOKEN=your_max_bot_token_here

# ============================================
# PYTHON ASTRO SERVICE (натальные карты)
# ============================================
ASTRO_SERVICE_URL=http://astro-service:8000

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_TTL=10080

# ============================================
# DOCKER PORTS
# ============================================
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
ASTRO_SERVICE_PORT=8001
