# ============================================
# APP
# ============================================
APP_NAME="AI Astrolog"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ai_astrolog
DB_USERNAME=ai_astrolog_user
DB_PASSWORD=secure_password_change_me

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ============================================
# TIMEWEB AI API
# ============================================
TIMEWEB_API_KEY=your_timeweb_ai_api_key_here
TIMEWEB_AI_MODEL=llama-3-70b
TIMEWEB_AI_TIMEOUT=60

# ============================================
# Т-БАНК (Эквайринг)
# ============================================
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_WEBHOOK_URL=https://your-domain.com/api/webhooks/tbank
TBANK_MODE=test

# ============================================
# UNISENDER (Email)
# ============================================
UNISENDER_API_KEY=
UNISENDER_SENDER_EMAIL=noreply@your-domain.com
UNISENDER_SENDER_NAME="AI Astrolog"

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=

# ============================================
# MAX BOT
# ============================================
MAX_BOT_TOKEN=
MAX_API_URL=

# ============================================
# PYTHON ASTRO SERVICE (натальные карты)
# ============================================
ASTRO_SERVICE_URL=http://astro-service:8001

# ============================================
# JWT AUTH / Sanctum
# ============================================
JWT_SECRET=
JWT_TTL=10080
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=database
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
